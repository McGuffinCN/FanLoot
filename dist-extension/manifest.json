{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extensionName__",
  "version": "1.5.1",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://fantia.jp/*",
    "https://*.fantia.jp/*",
    "https://fanbox.cc/*",
    "https://*.fanbox.cc/*",
    "https://*.pximg.net/*",
    "https://www.pixiv.net/*",
    "https://patreon.com/*",
    "https://*.patreon.com/*",
    "https://*.patreonusercontent.com/*",
    "https://pawchive.pw/*",
    "https://*.pawchive.pw/*",
    "https://iframely.net/*",
    "https://*.iframely.net/*",
    "https://iframe.ly/*",
    "https://*.iframe.ly/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantia.jp/*",
        "https://www.fanbox.cc/*",
        "https://*.fanbox.cc/*",
        "https://www.pixiv.net/fanbox/*",
        "https://www.patreon.com/*",
        "https://patreon.com/*",
        "https://pawchive.pw/*",
        "https://*.pawchive.pw/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
